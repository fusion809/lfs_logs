```
c++ -c simdutf.cpp  -nostdlib++ -fno-rtti -fno-exceptions -DSIMDUTF_NO_LIBCXX=1 -std=c++17
cc amalgamation_demo.c simdutf.o -o cdemo
./cdemo
```

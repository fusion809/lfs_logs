		/usr/share/applications; \
   else \
	cp ../runtime/vim.desktop \
		../runtime/gvim.desktop \
		/usr/share/applications; \
   fi; \
   if test -z "" -a -x "/usr/bin/update-desktop-database"; then \
      /usr/bin/update-desktop-database -q /usr/share/applications; \
   fi \
fi

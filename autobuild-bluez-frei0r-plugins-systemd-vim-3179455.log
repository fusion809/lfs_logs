   chmod 644 /usr/share/vim/vim92/keymap/README.txt /usr/share/vim/vim92/keymap/*.vim; \
fi
if test -d ../lang ; then \
  if test -n "en_AU.UTF-8" ; then \
    lngusr=${LANG%%.*} ; \
  elif test -n "" ; then \
    lngusr=${LANGUAGE%%:*} ; \
  elif test -n "" ; then \
    lngusr=${LC_MESSAGES%%.*} ; \
  fi; \
  if test "$lngusr" = "zh_TW" -o "$lngusr" = "zh_CN" -o "$lngusr" = "pt_BR" ; then \
    lngusr=`echo $lngusr | tr '[:upper:]' '[:lower:]'` ; \
  elif test -n "$lngusr" -a "$lngusr" != "C" -a "$lngusr" != "POSIX" ; then \
    lngusr=${lngusr%%_*} ; \
  fi ; \
  if test -f ../lang/README.$lngusr.txt ; then \
    cp ../lang/README.$lngusr.txt /usr/share/vim/vim92 ; \
    chmod 644 /usr/share/vim/vim92/README.$lngusr.txt ; \
  fi ; \
  if test -f ../lang/LICENSE.$lngusr.txt ; then \
    cp ../lang/LICENSE.$lngusr.txt /usr/share/vim/vim92 ; \
    chmod 644 /usr/share/vim/vim92/LICENSE.$lngusr.txt ; \
  fi ; \
fi
if test -n "/usr/share"; then \
	/bin/sh install-sh -c -d /usr/share/icons/hicolor/48x48/apps /usr/share/icons/locolor/32x32/apps \
	/usr/share/icons/locolor/16x16/apps /usr/share/applications; \
fi
if test -d /usr/share/icons/hicolor/48x48/apps -a -w /usr/share/icons/hicolor/48x48/apps \
	-a ! -f /usr/share/icons/hicolor/48x48/apps/gvim.png; then \
   cp ../runtime/vim48x48.png /usr/share/icons/hicolor/48x48/apps/gvim.png; \
   if test -z "" -a -x "/usr/bin/gtk-update-icon-cache" \

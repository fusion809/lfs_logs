	/usr/bin/gtk-update-icon-cache -q /usr/share/icons/hicolor; \
   fi \
fi
if test -d /usr/share/icons/locolor/32x32/apps -a -w /usr/share/icons/locolor/32x32/apps \
	-a ! -f /usr/share/icons/locolor/32x32/apps/gvim.png; then \

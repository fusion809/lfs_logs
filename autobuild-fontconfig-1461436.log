  if { if (LC_ALL=C find --version) 2>/dev/null | grep GNU >/dev/null; then \
	 LC_ALL=C find -L .. -maxdepth 1 -type f \
		       -size -10000000c -exec grep 'GNU fontconfig' \
		       /dev/null '{}' ';' 2>/dev/null; \
       else \
	 LC_ALL=C grep 'GNU fontconfig' ../* 2>/dev/null; \
       fi; \
     } | grep -v 'libtool:' >/dev/null; then \
     package_gnu=yes; \
   else \
     package_gnu=no; \
   fi; \
}; \
if test "$package_gnu" = "yes"; then \
  package_prefix='GNU '; \
else \
  package_prefix=''; \
fi; \
if test -n 'https://gitlab.freedesktop.org/fontconfig/fontconfig/issues/new' || test 'https://gitlab.freedesktop.org/fontconfig/fontconfig/issues/new' = '@'PACKAGE_BUGREPORT'@'; then \
  msgid_bugs_address='https://gitlab.freedesktop.org/fontconfig/fontconfig/issues/new'; \
else \
  msgid_bugs_address='https://gitlab.freedesktop.org/fontconfig/fontconfig/issues/new'; \
fi; \
case `/usr/bin/xgettext --version | sed 1q | sed -e 's,^[^0-9]*,,'` in \
  '' | 0.[0-9] | 0.[0-9].* | 0.1[0-5] | 0.1[0-5].* | 0.16 | 0.16.[0-1]*) \
    /usr/bin/xgettext --default-domain=fontconfig --directory=.. \
      --add-comments=TRANSLATORS: --keyword=_ --keyword=N_  \
      --files-from=./POTFILES.in \
      --copyright-holder='Fontconfig Author(s)' \
      --msgid-bugs-address="$msgid_bugs_address" \
    ;; \
  *) \
    /usr/bin/xgettext --default-domain=fontconfig --directory=.. \
      --add-comments=TRANSLATORS: --keyword=_ --keyword=N_  \
      --files-from=./POTFILES.in \
      --copyright-holder='Fontconfig Author(s)' \
      --package-name="${package_prefix}fontconfig" \
      --package-version='2.18.4' \
      --msgid-bugs-address="$msgid_bugs_address" \
    ;; \
esac
test ! -f fontconfig.po || { \
  if test -f ./fontconfig.pot-header; then \
    sed -e '1,/^#$/d' < fontconfig.po > fontconfig.1po && \
    cat ./fontconfig.pot-header fontconfig.1po > fontconfig.po; \
    rm -f fontconfig.1po; \
  fi; \
  if test -f ./fontconfig.pot; then \
    sed -f remove-potcdate.sed < ./fontconfig.pot > fontconfig.1po && \
    sed -f remove-potcdate.sed < fontconfig.po > fontconfig.2po && \
    if cmp fontconfig.1po fontconfig.2po >/dev/null 2>&1; then \
      rm -f fontconfig.1po fontconfig.2po fontconfig.po; \
    else \
      rm -f fontconfig.1po fontconfig.2po ./fontconfig.pot && \
      mv fontconfig.po ./fontconfig.pot; \
    fi; \
  else \
    mv fontconfig.po ./fontconfig.pot; \
  fi; \
}
